{
  "version": 2,
  "builds": [
    {
      "src": "functions/alexa-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "functions/stations-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/alexa$",
      "dest": "/functions/alexa-api.js"
    },
    {
      "src": "^/api/stations$",
      "dest": "/functions/stations-api.js"
    },
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/public/$1"
    }
  ]
}
